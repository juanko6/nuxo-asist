# Configuración global del stack de producción (docker compose up -d).
# Copia este fichero a .env y cambia los valores marcados como "cambia-...".

# --- Base de datos (solo red interna; no se publica al host) ---
POSTGRES_USER=asist
POSTGRES_PASSWORD=cambia-esta-password
POSTGRES_DB=asist

# --- API ---
# Genera un secreto propio:
#   openssl rand -hex 32
#   PowerShell: -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Maximum 16) })
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10
# Zona horaria de negocio para decidir qué es "hoy" al fichar (nombre IANA)
APP_TIMEZONE=Europe/Madrid
LOG_LEVEL=info

# --- Cierre automático de turnos olvidados (HU-03) ---
# Avisa al empleado pasada la hora teórica + WARN min, y cierra el turno pasada
# la hora teórica + GRACE min. Sin horario asignado, cierra a las MAX_SHIFT_HOURS.
AUTO_CLOSE_ENABLED=true
AUTO_CLOSE_CRON=*/5 * * * *
AUTO_CLOSE_WARN_MINUTES=15
AUTO_CLOSE_GRACE_MINUTES=30
MAX_SHIFT_HOURS=12

# --- Ausencias injustificadas (HU-01) ---
# Cron diario que detecta ausencias del día anterior y avisa (in-app).
ABSENCE_CHECK_ENABLED=true
ABSENCE_CHECK_CRON=0 6 * * *
# Envío de email (HU-01). Si EMAIL_ENABLED=true y hay SMTP_HOST, se envía por SMTP.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=nuxoasist <no-reply@nuxoasist.app>
# Buzón al que llegan los tickets de soporte
SUPPORT_EMAIL=nuxoasist@gmail.com

# --- Rate limiting (hardening) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
# Límite estricto para POST /auth/login (frena fuerza bruta)
AUTH_RATE_LIMIT_MAX=10

# --- Backups (retención legal 4 años) ---
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=48

# --- HTTPS con Caddy (docker-compose.tls.yml) ---
# Dominio público que apunta al servidor (necesario para los certificados)
PUBLIC_DOMAIN=asistencia.tudominio.com

# --- Web (nginx) ---
# Puerto del host donde se publica la aplicación (frontend)
WEB_PORT=3000
# Puerto del host donde se publica la API directamente
API_PORT=8000
# Origen público de la app; con nginx como proxy todo va por el mismo origen,
# así que solo importa si sirves el frontend desde otro dominio
CORS_ORIGIN=http://localhost:3000

