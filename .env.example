# Configuración global del stack de producción (docker compose up -d).
# Copia este fichero a .env y cambia los valores marcados como "cambia-...".

# --- Base de datos (solo red interna; no se publica al host) ---
POSTGRES_USER=asist
POSTGRES_PASSWORD=cambia-esta-password
POSTGRES_DB=asist

# --- API ---
# Genera un secreto propio:
#   openssl rand -hex 32
#   PowerShell: -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Maximum 16) })
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10
# Zona horaria de negocio para decidir qué es "hoy" al fichar (nombre IANA)
APP_TIMEZONE=Europe/Madrid
LOG_LEVEL=info

# --- Cierre automático de turnos olvidados (HU-03) ---
# Avisa al empleado pasada la hora teórica + WARN min, y cierra el turno pasada
# la hora teórica + GRACE min. Sin horario asignado, cierra a las MAX_SHIFT_HOURS.
AUTO_CLOSE_ENABLED=true
AUTO_CLOSE_CRON=*/5 * * * *
AUTO_CLOSE_WARN_MINUTES=15
AUTO_CLOSE_GRACE_MINUTES=30
MAX_SHIFT_HOURS=12

# --- Ausencias injustificadas (HU-01) ---
# Cron diario que detecta ausencias del día anterior y avisa (in-app).
ABSENCE_CHECK_ENABLED=true
ABSENCE_CHECK_CRON=0 6 * * *
# Envío de email: deshabilitado por ahora (el aviso efectivo es in-app)
EMAIL_ENABLED=false

# --- Web (nginx) ---
# Puerto del host donde se publica la aplicación
WEB_PORT=8080
# Origen público de la app; con nginx como proxy todo va por el mismo origen,
# así que solo importa si sirves el frontend desde otro dominio
CORS_ORIGIN=http://localhost:8080

# --- Seed inicial (docker compose --profile tools run --rm seed) ---
SEED_ADMIN_EMAIL=admin@empresa.com
SEED_ADMIN_PASSWORD=cambiar-admin-123
