# Conexión a PostgreSQL
DATABASE_URL=postgres://asist:asist@localhost:5432/asist

# Secreto para firmar los JWT. Genera uno propio: openssl rand -hex 32
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio

# Tiempo de vida del token (formato ms/vercel: 8h, 30m, 7d)
JWT_EXPIRES_IN=8h

# Puerto y host de escucha del API
PORT=3000
HOST=0.0.0.0

# Origen permitido para CORS (la URL del frontend en dev)
CORS_ORIGIN=http://localhost:5173

# Coste de bcrypt (10 es un buen valor por defecto)
BCRYPT_ROUNDS=10

# Zona horaria de negocio para decidir qué es "hoy" al fichar (nombre IANA)
APP_TIMEZONE=Europe/Madrid

# Cierre automático de turnos olvidados (HU-03). En dev puedes desactivarlo.
AUTO_CLOSE_ENABLED=true
AUTO_CLOSE_CRON=*/5 * * * *
AUTO_CLOSE_WARN_MINUTES=15
AUTO_CLOSE_GRACE_MINUTES=30
MAX_SHIFT_HOURS=12
